+MojoResult OpTrapCreate(Harness* h,
+                        EventWriter* w,
+                        uint64_t op_id,
+                        const base::DictValue& args,
+                        const base::DictValue& expect) {
+  const base::ListValue* produce = expect.FindList("produce");
+  std::string token = (produce && !produce->empty()) ? (*produce)[0].GetString() : "t0";
+  MojoHandle trap;
+  // The epoch removed the `context` parameter: the process runs one casefile,
+  // so the harness is reachable via the process-global `g_harness`.
+  MojoResult r = MojoCreateTrap(&TrapHandler, nullptr, &trap);
+  if (r == MOJO_RESULT_OK) {
+    h->traps[token] = trap;
+  }
+  base::DictValue extra;
+  w->Emit(op_id, "result", ResultName(r), extra);
+  return r;
+}
+
+MojoResult OpTrapAddTrigger(Harness* h,
+                            EventWriter* w,
+                            uint64_t op_id,
+                            const base::DictValue& args) {
+  const std::string* trap_token = args.FindString("trap");
+  const std::string* handle_token = args.FindString("handle");
+  base::DictValue extra;
+  auto tit = h->traps.find(*trap_token);
+  if (tit == h->traps.end()) {
+    w->Emit(op_id, "result", "MOJO_RESULT_INVALID_ARGUMENT", extra);
+    return MOJO_RESULT_INVALID_ARGUMENT;
+  }
+  MojoHandle handle;
+  if (!handle_token || h->GetHandle(*handle_token, &handle) != MOJO_RESULT_OK) {
+    w->Emit(op_id, "result", "MOJO_RESULT_INVALID_ARGUMENT", extra);
+    return MOJO_RESULT_INVALID_ARGUMENT;
+  }
+  MojoHandleSignals signals = MOJO_HANDLE_SIGNAL_NONE;
+  if (const base::ListValue* sl = args.FindList("signals")) {
+    for (const auto& s : *sl) {
+      signals |= SignalFromName(s.GetString());
+    }
+  }
+  uint64_t context = 0;
+  if (args.contains("context")) {
+    context = static_cast<uint64_t>(args.FindInt("context").value_or(0));
+  }
+  MojoResult r =
+      MojoAddTrigger(tit->second, handle, signals,
+                     MOJO_TRIGGER_CONDITION_SIGNALS_SATISFIED,
+                     static_cast<uintptr_t>(context), nullptr);
+  if (r == MOJO_RESULT_OK) {
+    std::lock_guard<std::mutex> lock(g_context_tokens_mutex);
+    g_context_tokens[static_cast<uintptr_t>(context)] = *trap_token;
+  }
+  w->Emit(op_id, "result", ResultName(r), extra);
+  return r;
+}
+
+MojoResult OpTrapArm(Harness* h,
+                     EventWriter* w,
+                     uint64_t op_id,
+                     const base::DictValue& args) {
+  const std::string* trap_token = args.FindString("trap");
+  base::DictValue extra;
+  auto tit = h->traps.find(*trap_token);
+  if (tit == h->traps.end()) {
+    w->Emit(op_id, "result", "MOJO_RESULT_INVALID_ARGUMENT", extra);
+    return MOJO_RESULT_INVALID_ARGUMENT;
+  }
+  uint32_t num_events = 4;
+  MojoTrapEvent events[4] = {};
+  events[0].struct_size = sizeof(MojoTrapEvent);
+  MojoResult r = MojoArmTrap(tit->second, nullptr, &num_events, events);
+  if (r == MOJO_RESULT_FAILED_PRECONDITION) {
+    // Immediate events were written into `events`; emit them, then drain any
+    // additional queued events.
+    for (uint32_t i = 0; i < num_events; ++i) {
+      base::DictValue ev;
+      ev.Set("trigger_context", static_cast<int>(events[i].trigger_context));
+      ev.Set("signals_state", SignalsStateJson(events[i].signals_state));
+      ev.Set("result", ResultName(events[i].result));
+      w->Emit(op_id, "trap", "MOJO_RESULT_OK", ev);
+    }
+    {
+      std::lock_guard<std::mutex> lock(h->trap_mutex);
+      auto it = h->trap_events.find(*trap_token);
+      if (it != h->trap_events.end()) {
+        for (const auto& e : it->second) {
+          base::DictValue ev;
+          ev.Set("trigger_context", static_cast<int>(e.trigger_context));
+          ev.Set("signals_state", SignalsStateJson(e.signals_state));
+          ev.Set("result", ResultName(e.result));
+          w->Emit(op_id, "trap", "MOJO_RESULT_OK", ev);
+        }
+        it->second.clear();
+      }
+    }
+  }
+  w->Emit(op_id, "result", ResultName(r), extra);
+  return r;
+}
+
+MojoResult OpTrapRemoveTrigger(Harness* h,
+                               EventWriter* w,
+                               uint64_t op_id,
+                               const base::DictValue& args) {
+  const std::string* trap_token = args.FindString("trap");
+  uint64_t context = 0;
+  if (args.contains("context")) {
+    context = static_cast<uint64_t>(args.FindInt("context").value_or(0));
+  }
+  base::DictValue extra;
+  auto tit = h->traps.find(*trap_token);
+  if (tit == h->traps.end()) {
+    w->Emit(op_id, "result", "MOJO_RESULT_INVALID_ARGUMENT", extra);
+    return MOJO_RESULT_INVALID_ARGUMENT;
+  }
+  // The epoch's MojoRemoveTrigger identifies the trigger by context alone.
+  MojoResult r =
+      MojoRemoveTrigger(tit->second, static_cast<uintptr_t>(context), nullptr);
+  if (r == MOJO_RESULT_OK) {
+    std::lock_guard<std::mutex> lock(g_context_tokens_mutex);
+    g_context_tokens.erase(static_cast<uintptr_t>(context));
+  }
+  w->Emit(op_id, "result", ResultName(r), extra);
+  return r;
+}
+
+MojoResult OpTrapClose(Harness* h,
+                       EventWriter* w,
+                       uint64_t op_id,
+                       const base::DictValue& args) {
+  const std::string* trap_token = args.FindString("trap");
+  base::DictValue extra;
+  auto it = h->traps.find(*trap_token);
+  if (it == h->traps.end()) {
+    w->Emit(op_id, "result", "MOJO_RESULT_INVALID_ARGUMENT", extra);
+    return MOJO_RESULT_INVALID_ARGUMENT;
+  }
+  MojoResult r = MojoClose(it->second);
+  h->traps.erase(it);
+  w->Emit(op_id, "result", ResultName(r), extra);
+  return r;
+}
+
+MojoResult OpDrainTrapEvents(Harness* h,
+                             EventWriter* w,
+                             uint64_t op_id,
+                             const base::DictValue& args) {
+  const std::string* trap_token = args.FindString("trap");
+  int count = args.FindInt("count").value_or(1);
+  std::vector<MojoTrapEvent> drained;
+  auto poll = [&]() {
+    std::lock_guard<std::mutex> lock(h->trap_mutex);
+    auto it = h->trap_events.find(*trap_token);
+    if (it != h->trap_events.end()) {
+      for (auto& e : it->second) {
+        drained.push_back(e);
+      }
+      it->second.clear();
+    }
+  };
+  poll();
+  int64_t deadline_us = (base::TimeTicks::Now() + base::Seconds(5))
+                            .since_origin()
+                            .InMicroseconds();
+  while (static_cast<int>(drained.size()) < count &&
+         base::TimeTicks::Now().since_origin().InMicroseconds() < deadline_us) {
+    usleep(2000);
+    poll();
+  }
+  for (const auto& e : drained) {
+    base::DictValue ev;
+    ev.Set("trigger_context", static_cast<int>(e.trigger_context));
+    ev.Set("signals_state", SignalsStateJson(e.signals_state));
+    ev.Set("result", ResultName(e.result));
+    w->Emit(op_id, "trap", "MOJO_RESULT_OK", ev);
+  }
+  base::DictValue extra;
+  w->Emit(op_id, "result", "MOJO_RESULT_OK", extra);
+  return MOJO_RESULT_OK;
+}
+
+// ---------------------------------------------------------------------------
+// Cross-process invitation modes (Phase 3 bootstrap).
+//
+//   invite-broker  <socket-fd> <events.jsonl>
+//   invite-acceptor <socket-fd> <events.jsonl>
+//
+// The broker and acceptor run the OFFICIAL invitation flow over a Unix
+// socketpair: the broker (initialized as the ipcz broker) creates an
+// invitation, attaches a message pipe named "bootstrap", and sends it over
+// the socket; the acceptor accepts and extracts the pipe. They then exchange
+// one message plus one wrapped platform descriptor in each direction over the
+// bootstrap pipe.
+// ---------------------------------------------------------------------------
+
+namespace invite {
+
+// Build the invitation transport endpoint for a socket fd. The platform
+// handle must outlive the endpoint; a static is safe because the driver runs
+// one invitation flow per process.
+MojoInvitationTransportEndpoint SocketEndpoint(int fd) {
+  static MojoPlatformHandle platform_handle = {
+      sizeof(MojoPlatformHandle), MOJO_PLATFORM_HANDLE_TYPE_FILE_DESCRIPTOR, 0};
+  platform_handle.value = static_cast<uint64_t>(fd);
+  MojoInvitationTransportEndpoint endpoint = {
+      sizeof(MojoInvitationTransportEndpoint), MOJO_INVITATION_TRANSPORT_TYPE_CHANNEL,
+      1, &platform_handle};
+  return endpoint;
+}
+
+// Send a payload plus a wrapped memfd on a message pipe.
+MojoResult SendPayloadWithFd(MojoHandle pipe,
+                             const std::string& payload,
+                             const std::string& fd_content) {
+  int fd = memfd_create("oracle-invite", 0);
+  if (fd < 0) {
+    return MOJO_RESULT_RESOURCE_EXHAUSTED;
+  }
+  if (!fd_content.empty()) {
+    (void)!write(fd, fd_content.data(), fd_content.size());
+  }
+  MojoPlatformHandle platform = {sizeof(MojoPlatformHandle),
+                                 MOJO_PLATFORM_HANDLE_TYPE_FILE_DESCRIPTOR,
+                                 static_cast<uint64_t>(fd)};
+  MojoHandle wrapped;
+  MojoResult r = MojoWrapPlatformHandle(&platform, nullptr, &wrapped);
+  if (r != MOJO_RESULT_OK) {
+    close(fd);
+    return r;
+  }
+
+  MojoMessageHandle message;
+  r = MojoCreateMessage(nullptr, &message);
+  if (r != MOJO_RESULT_OK) {
+    return r;
+  }
+  void* buffer = nullptr;
+  uint32_t buffer_size = 0;
+  r = MojoAppendMessageData(message, static_cast<uint32_t>(payload.size()), &wrapped, 1,
+                            nullptr, &buffer, &buffer_size);
+  if (r == MOJO_RESULT_OK && !payload.empty()) {
+    memcpy(buffer, payload.data(), payload.size());
+  }
+  if (r == MOJO_RESULT_OK) {
+    r = MojoWriteMessage(pipe, message, nullptr);
+  } else {
+    MojoDestroyMessage(message);
+  }
+  return r;
+}
+
+// Receive a payload plus an attached fd on a message pipe; fills `payload`
+// and reads the descriptor's content into `fd_content`. Polls on
+// MOJO_RESULT_SHOULD_WAIT (ipcz reads are non-blocking) up to a 10s deadline.
+MojoResult RecvPayloadWithFd(MojoHandle pipe,
+                             std::string* payload,
+                             std::string* fd_content) {
+  MojoMessageHandle message;
+  MojoResult r = MOJO_RESULT_SHOULD_WAIT;
+  const base::TimeTicks deadline = base::TimeTicks::Now() + base::Seconds(10);
+  while (r == MOJO_RESULT_SHOULD_WAIT && base::TimeTicks::Now() < deadline) {
+    r = MojoReadMessage(pipe, nullptr, &message);
+    if (r == MOJO_RESULT_SHOULD_WAIT) {
+      usleep(1000);
+    }
+  }
+  if (r != MOJO_RESULT_OK) {
+    return r;
+  }
+  uint32_t num_bytes = 0;
+  uint32_t num_handles = 0;
+  void* buffer = nullptr;
+  r = MojoGetMessageData(message, nullptr, &buffer, &num_bytes, nullptr, &num_handles);
+  std::vector<MojoHandle> handles;
+  if (r == MOJO_RESULT_RESOURCE_EXHAUSTED && num_handles > 0) {
+    handles.resize(num_handles);
+    r = MojoGetMessageData(message, nullptr, &buffer, &num_bytes, handles.data(),
+                           &num_handles);
+  }
+  if (r == MOJO_RESULT_OK) {
+    payload->assign(static_cast<const char*>(buffer), num_bytes);
+    if (!handles.empty()) {
+      MojoPlatformHandle platform = {sizeof(MojoPlatformHandle),
+                                     MOJO_PLATFORM_HANDLE_TYPE_INVALID, 0};
+      MojoResult u = MojoUnwrapPlatformHandle(handles[0], nullptr, &platform);
+      if (u == MOJO_RESULT_OK &&
+          platform.type == MOJO_PLATFORM_HANDLE_TYPE_FILE_DESCRIPTOR) {
+        int fd = static_cast<int>(platform.value);
+        lseek(fd, 0, SEEK_SET);
+        char buf[4096];
+        ssize_t n;
+        while ((n = read(fd, buf, sizeof(buf))) > 0) {
+          fd_content->append(buf, n);
+        }
+        close(fd);
+      }
+    }
+  }
+  MojoDestroyMessage(message);
+  return r;
+}
+
+// Send a payload (no handles) on a message pipe.
+MojoResult SendPayload(MojoHandle pipe, const std::string& payload) {
+  MojoMessageHandle message;
+  MojoResult r = MojoCreateMessage(nullptr, &message);
+  if (r != MOJO_RESULT_OK) {
+    return r;
+  }
+  void* buffer = nullptr;
+  uint32_t buffer_size = 0;
+  r = MojoAppendMessageData(message, static_cast<uint32_t>(payload.size()), nullptr, 0,
+                            nullptr, &buffer, &buffer_size);
+  if (r == MOJO_RESULT_OK && !payload.empty()) {
+    memcpy(buffer, payload.data(), payload.size());
+  }
+  if (r == MOJO_RESULT_OK) {
+    r = MojoWriteMessage(pipe, message, nullptr);
+  } else {
+    MojoDestroyMessage(message);
+  }
+  return r;
+}
+
+// Send a payload plus an attached message-pipe handle (portal transfer) on a
+// message pipe. The handle is consumed by the write on success.
+MojoResult SendMessageWithHandle(MojoHandle pipe,
+                                 const std::string& payload,
+                                 MojoHandle attached) {
+  MojoMessageHandle message;
+  MojoResult r = MojoCreateMessage(nullptr, &message);
+  if (r != MOJO_RESULT_OK) {
+    return r;
+  }
+  void* buffer = nullptr;
+  uint32_t buffer_size = 0;
+  r = MojoAppendMessageData(message, static_cast<uint32_t>(payload.size()), &attached, 1,
+                            nullptr, &buffer, &buffer_size);
+  if (r == MOJO_RESULT_OK && !payload.empty()) {
+    memcpy(buffer, payload.data(), payload.size());
+  }
+  if (r == MOJO_RESULT_OK) {
+    r = MojoWriteMessage(pipe, message, nullptr);
+  } else {
+    MojoDestroyMessage(message);
+  }
+  return r;
+}
+
+// Receive a payload (no handles) on a message pipe, polling on
+// MOJO_RESULT_SHOULD_WAIT up to a 10s deadline.
+MojoResult RecvPayload(MojoHandle pipe, std::string* payload) {
+  MojoMessageHandle message;
+  MojoResult r = MOJO_RESULT_SHOULD_WAIT;
+  const base::TimeTicks deadline = base::TimeTicks::Now() + base::Seconds(10);
+  while (r == MOJO_RESULT_SHOULD_WAIT && base::TimeTicks::Now() < deadline) {
+    r = MojoReadMessage(pipe, nullptr, &message);
+    if (r == MOJO_RESULT_SHOULD_WAIT) {
+      usleep(1000);
+    }
+  }
+  if (r != MOJO_RESULT_OK) {
+    return r;
+  }
+  uint32_t num_bytes = 0;
+  uint32_t num_handles = 0;
+  void* buffer = nullptr;
+  r = MojoGetMessageData(message, nullptr, &buffer, &num_bytes, nullptr, &num_handles);
+  if (r == MOJO_RESULT_OK) {
+    payload->assign(static_cast<const char*>(buffer), num_bytes);
+  }
+  MojoDestroyMessage(message);
+  return r;
+}
+
+// Receive a payload plus exactly one attached message-pipe handle (portal
+// transfer), polling on MOJO_RESULT_SHOULD_WAIT up to a 10s deadline. The
+// extracted handle is returned in `out_handle` (never closed here).
+MojoResult RecvMessageWithHandle(MojoHandle pipe,
+                                 std::string* payload,
+                                 MojoHandle* out_handle) {
+  MojoMessageHandle message;
+  MojoResult r = MOJO_RESULT_SHOULD_WAIT;
+  const base::TimeTicks deadline = base::TimeTicks::Now() + base::Seconds(10);
+  while (r == MOJO_RESULT_SHOULD_WAIT && base::TimeTicks::Now() < deadline) {
+    r = MojoReadMessage(pipe, nullptr, &message);
+    if (r == MOJO_RESULT_SHOULD_WAIT) {
+      usleep(1000);
+    }
+  }
+  if (r != MOJO_RESULT_OK) {
+    fprintf(stderr, "RecvMessageWithHandle: MojoReadMessage -> %s\n",
+            ResultName(r).c_str());
+    MojoHandleSignalsState state = {0};
+    MojoQueryHandleSignalsState(pipe, &state);
+    fprintf(stderr, "  pipe signals: satisfied=%s satisfiable=%s\n",
+            SignalNames(state.satisfied_signals).DebugString().c_str(),
+            SignalNames(state.satisfiable_signals).DebugString().c_str());
+    return r;
+  }
+  uint32_t num_bytes = 0;
+  uint32_t num_handles = 0;
+  void* buffer = nullptr;
+  r = MojoGetMessageData(message, nullptr, &buffer, &num_bytes, nullptr, &num_handles);
+  MojoHandle handle = MOJO_HANDLE_INVALID;
+  if (r == MOJO_RESULT_RESOURCE_EXHAUSTED && num_handles > 0) {
+    std::vector<MojoHandle> handles(num_handles);
+    r = MojoGetMessageData(message, nullptr, &buffer, &num_bytes, handles.data(),
+                           &num_handles);
+    if (r == MOJO_RESULT_OK) {
+      handle = handles[0];
+    }
+  }
+  if (r == MOJO_RESULT_OK) {
+    payload->assign(static_cast<const char*>(buffer), num_bytes);
+    *out_handle = handle;
+  }
+  MojoDestroyMessage(message);
+  return r;
+}
+
+int RunBroker(int socket_fd, const char* events_path) {
+  struct stat st;
+  if (fstat(socket_fd, &st) != 0) {
+    fprintf(stderr, "broker: fstat(%d) failed: %s\n", socket_fd,
+            strerror(errno));
+    return 1;
+  }
+  fprintf(stderr, "broker: fd %d is_socket=%d\n", socket_fd, S_ISSOCK(st.st_mode));
+  mojo::core::Configuration config;
+  config.is_broker_process = true;
+  config.force_direct_shared_memory_allocation = true;
+  mojo::core::Init(config);
+
+  EventWriter writer(events_path);
+  writer.Emit(0, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+
+  MojoHandle invitation;
+  MojoResult r = MojoCreateInvitation(nullptr, &invitation);
+  base::DictValue extra;
+  writer.Emit(1, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    fprintf(stderr, "MojoCreateInvitation: %s\n", ResultName(r).c_str());
+    writer.WriteOut();
+    return 1;
+  }
+
+  MojoHandle pipe;
+  r = MojoAttachMessagePipeToInvitation(invitation, "bootstrap", 9, nullptr, &pipe);
+  writer.Emit(2, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    fprintf(stderr, "MojoAttachMessagePipeToInvitation: %s\n", ResultName(r).c_str());
+    writer.WriteOut();
+    return 1;
+  }
+
+  MojoInvitationTransportEndpoint endpoint = SocketEndpoint(socket_fd);
+  r = MojoSendInvitation(invitation, nullptr, &endpoint, nullptr, 0, nullptr);
+  writer.Emit(3, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    fprintf(stderr, "MojoSendInvitation: %s\n", ResultName(r).c_str());
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Exchange: broker sends a message + fd, then receives the reply + fd.
+  r = SendPayloadWithFd(pipe, "hello-from-broker", "fd-from-broker");
+  writer.Emit(4, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    fprintf(stderr, "broker SendPayloadWithFd: %s\n", ResultName(r).c_str());
+    writer.WriteOut();
+    return 1;
+  }
+
+  std::string payload, fd_content;
+  r = RecvPayloadWithFd(pipe, &payload, &fd_content);
+  base::DictValue recv_extra;
+  recv_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  recv_extra.Set("fd_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(fd_content.data()), fd_content.size()));
+  writer.Emit(5, "message", ResultName(r), recv_extra);
+
+  // MojoSendInvitation consumes the invitation handle on success; only the
+  // pipe end (and, on failure, nothing) remains to close.
+  MojoClose(pipe);
+  writer.Emit(6, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  writer.WriteOut();
+  return (r == MOJO_RESULT_OK && payload == "hello-from-acceptor" &&
+          fd_content == "fd-from-acceptor")
+             ? 0
+             : 1;
+}
+
+int RunAcceptor(int socket_fd, const char* events_path) {
+  mojo::core::Init();
+
+  EventWriter writer(events_path);
+  writer.Emit(0, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+
+  MojoInvitationTransportEndpoint endpoint = SocketEndpoint(socket_fd);
+  MojoHandle invitation;
+  MojoResult r = MojoAcceptInvitation(&endpoint, nullptr, &invitation);
+  base::DictValue extra;
+  writer.Emit(1, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    fprintf(stderr, "MojoAcceptInvitation: %s\n", ResultName(r).c_str());
+    writer.WriteOut();
+    return 1;
+  }
+
+  MojoHandle pipe;
+  r = MojoExtractMessagePipeFromInvitation(invitation, "bootstrap", 9, nullptr, &pipe);
+  writer.Emit(2, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    fprintf(stderr, "MojoExtractMessagePipeFromInvitation: %s\n", ResultName(r).c_str());
+    writer.WriteOut();
+    return 1;
+  }
+
+  std::string payload, fd_content;
+  r = RecvPayloadWithFd(pipe, &payload, &fd_content);
+  base::DictValue recv_extra;
+  recv_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  recv_extra.Set("fd_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(fd_content.data()), fd_content.size()));
+  writer.Emit(3, "message", ResultName(r), recv_extra);
+  if (r != MOJO_RESULT_OK || payload != "hello-from-broker" ||
+      fd_content != "fd-from-broker") {
+    writer.WriteOut();
+    return 1;
+  }
+
+  r = SendPayloadWithFd(pipe, "hello-from-acceptor", "fd-from-acceptor");
+  writer.Emit(4, "result", ResultName(r), extra);
+
+  MojoClose(pipe);
+  MojoClose(invitation);
+  writer.Emit(5, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  writer.WriteOut();
+  return (r == MOJO_RESULT_OK) ? 0 : 1;
+}
+
+// ---------------------------------------------------------------------------
+// Phase 5 routing scenario (official broker and acceptor sides):
+//
+//   invite-broker-routing  <socket-fd> <events.jsonl>
+//   invite-acceptor-routing <socket-fd> <events.jsonl>
+//
+// Exercises portal transfer (endpoint migration) in both directions plus
+// proxy bypass:
+//   1. broker creates (A, B); sends B to the acceptor through the bootstrap
+//      pipe (the WithLocalPeer serialization path at the broker).
+//   2. broker writes "w1" on A -> routes over the wire to the acceptor's B'.
+//   3. acceptor writes "r1" on B' -> routes over the wire to the broker's A.
+//   4. acceptor sends B' back through the bootstrap pipe (the proxy
+//      serialization path at the acceptor; the broker completes the bypass
+//      with a local link and sends StopProxying to the acceptor's proxy).
+//   5. broker writes "w2" on A -> delivered locally to the re-extracted B''.
+//   6. broker closes A, B'', and the bootstrap pipe (RouteClosed propagation).
+// ---------------------------------------------------------------------------
+
+int RunRoutingBroker(int socket_fd, const char* events_path) {
+  mojo::core::Configuration config;
+  config.is_broker_process = true;
+  config.force_direct_shared_memory_allocation = true;
+  mojo::core::Init(config);
+
+  EventWriter writer(events_path);
+  writer.Emit(0, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  base::DictValue extra;
+
+  MojoHandle invitation;
+  MojoResult r = MojoCreateInvitation(nullptr, &invitation);
+  writer.Emit(1, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  MojoHandle pipe;
+  r = MojoAttachMessagePipeToInvitation(invitation, "bootstrap", 9, nullptr, &pipe);
+  writer.Emit(2, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  MojoInvitationTransportEndpoint endpoint = SocketEndpoint(socket_fd);
+  r = MojoSendInvitation(invitation, nullptr, &endpoint, nullptr, 0, nullptr);
+  writer.Emit(3, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  MojoHandle a, b;
+  r = MojoCreateMessagePipe(nullptr, &a, &b);
+  writer.Emit(4, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Transfer B to the acceptor through the bootstrap pipe.
+  r = SendMessageWithHandle(pipe, "transfer-b1", b);
+  writer.Emit(5, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // w1 routes over the wire to the acceptor's B'.
+  r = SendPayload(a, "w1");
+  writer.Emit(6, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  std::string payload;
+  r = RecvPayload(a, &payload);
+  base::DictValue recv_extra;
+  recv_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  writer.Emit(7, "message", ResultName(r), recv_extra);
+  if (r != MOJO_RESULT_OK || payload != "r1") {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // The acceptor sends B' back; the broker completes the bypass locally and
+  // extracts B''.
+  MojoHandle b2;
+  r = RecvMessageWithHandle(pipe, &payload, &b2);
+  base::DictValue back_extra;
+  back_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  back_extra.Set("handles", static_cast<int>(b2 != MOJO_HANDLE_INVALID ? 1 : 0));
+  writer.Emit(8, "message", ResultName(r), back_extra);
+  if (r != MOJO_RESULT_OK || payload != "transfer-back" ||
+      b2 == MOJO_HANDLE_INVALID) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // w2 routes locally from A to B'' (the bypass completed during the
+  // extraction above).
+  r = SendPayload(a, "w2");
+  writer.Emit(9, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  r = RecvPayload(b2, &payload);
+  base::DictValue w2_extra;
+  w2_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  writer.Emit(10, "message", ResultName(r), w2_extra);
+  if (r != MOJO_RESULT_OK || payload != "w2") {
+    writer.WriteOut();
+    return 1;
+  }
+
+  MojoClose(a);
+  writer.Emit(11, "result", ResultName(MOJO_RESULT_OK), extra);
+  MojoClose(b2);
+  writer.Emit(12, "result", ResultName(MOJO_RESULT_OK), extra);
+  MojoClose(pipe);
+  writer.Emit(13, "result", ResultName(MOJO_RESULT_OK), extra);
+
+  writer.Emit(14, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  writer.WriteOut();
+  return 0;
+}
+
+int RunRoutingAcceptor(int socket_fd, const char* events_path) {
+  mojo::core::Init();
+
+  EventWriter writer(events_path);
+  writer.Emit(0, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  base::DictValue extra;
+
+  MojoInvitationTransportEndpoint endpoint = SocketEndpoint(socket_fd);
+  MojoHandle invitation;
+  MojoResult r = MojoAcceptInvitation(&endpoint, nullptr, &invitation);
+  writer.Emit(1, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  MojoHandle pipe;
+  r = MojoExtractMessagePipeFromInvitation(invitation, "bootstrap", 9, nullptr, &pipe);
+  writer.Emit(2, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Receive B' (the transferred portal).
+  std::string payload;
+  MojoHandle b1;
+  r = RecvMessageWithHandle(pipe, &payload, &b1);
+  base::DictValue t_extra;
+  t_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  t_extra.Set("handles", static_cast<int>(b1 != MOJO_HANDLE_INVALID ? 1 : 0));
+  writer.Emit(3, "message", ResultName(r), t_extra);
+  if (r != MOJO_RESULT_OK || payload != "transfer-b1" ||
+      b1 == MOJO_HANDLE_INVALID) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Receive w1 over the wire.
+  r = RecvPayload(b1, &payload);
+  base::DictValue w1_extra;
+  w1_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  writer.Emit(4, "message", ResultName(r), w1_extra);
+  if (r != MOJO_RESULT_OK || payload != "w1") {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // r1 routes over the wire back to the broker's A.
+  r = SendPayload(b1, "r1");
+  writer.Emit(5, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Transfer B' back through the bootstrap pipe (the proxy path).
+  r = SendMessageWithHandle(pipe, "transfer-back", b1);
+  writer.Emit(6, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // The broker closes its bootstrap end: the read fails with
+  // FAILED_PRECONDITION (peer closed).
+  r = RecvPayload(pipe, &payload);
+  base::DictValue c_extra;
+  c_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  writer.Emit(7, "message", ResultName(r), c_extra);
+
+  MojoClose(pipe);
+  MojoClose(invitation);
+  writer.Emit(8, "result", ResultName(MOJO_RESULT_OK), extra);
+  writer.Emit(9, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  writer.WriteOut();
+  return (r == MOJO_RESULT_FAILED_PRECONDITION) ? 0 : 1;
+}
+
+// The Phase 5 memory-expansion scenario (official broker and acceptor sides):
+//
+//   invite-broker-memory  <socket-fd> <events.jsonl>
+//   invite-acceptor-memory <socket-fd> <events.jsonl>
+//
+// Seals the RequestMemory / ProvideMemory / AddBlockBuffer block-capacity
+// expansion deterministically:
+//   1. the broker transfers B through the bootstrap pipe and writes w1 on A;
+//   2. the acceptor sends m0..m8 (9 x 200-byte parcels) on B' — the primary
+//      buffer's 256-byte pool holds exactly 8 allocable blocks, so m8's
+//      fragment allocation fails and triggers RequestBlockCapacity(256),
+//      which (the acceptor is the allocation delegate) sends RequestMemory
+//      to the broker; m8 itself travels inline;
+//   3. the acceptor sends a "sync" marker on the bootstrap pipe; the broker
+//      reads m0..m8 from A only after receiving it, so the 256-blocks stay
+//      allocated at m8's put;
+//   4. the acceptor sends the transfer-back (B' + handle) through the
+//      bootstrap; the ProvideMemory round trip completes during this
+//      exchange (the broker replies with a 64 KiB memfd; the acceptor
+//      initializes it as a 256-byte block allocator, shares it via
+//      AddBlockBuffer{id=1, 256}, and registers it);
+//   5. the broker does a w2 round trip on A/B'' and then sends w3 on the
+//      bootstrap; receiving w3 guarantees the expansion completed on the
+//      acceptor side (ProvideMemory precedes w3 in arrival order);
+//   6. the acceptor sends m9 and m10 on the bootstrap — deterministically
+//      fragment-backed from the new buffer;
+//   7. the broker reads m9/m10, then closes A, B'', and the bootstrap pipe
+//      (RouteClosed propagation to the acceptor).
+// ---------------------------------------------------------------------------
+
+// The deterministic 200-byte memory-court payload m{NN} + 'x' padding.
+std::string MemoryPayload(int i) {
+  std::string p = "m";
+  if (i < 10) {
+    p += "0";
+  }
+  p += std::to_string(i);
+  p.resize(200, 'x');
+  return p;
+}
+
+int RunMemoryBroker(int socket_fd, const char* events_path) {
+  mojo::core::Configuration config;
+  config.is_broker_process = true;
+  config.force_direct_shared_memory_allocation = true;
+  mojo::core::Init(config);
+
+  EventWriter writer(events_path);
+  writer.Emit(0, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  base::DictValue extra;
+
+  MojoHandle invitation;
+  MojoResult r = MojoCreateInvitation(nullptr, &invitation);
+  writer.Emit(1, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  MojoHandle pipe;
+  r = MojoAttachMessagePipeToInvitation(invitation, "bootstrap", 9, nullptr, &pipe);
+  writer.Emit(2, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  MojoInvitationTransportEndpoint endpoint = SocketEndpoint(socket_fd);
+  r = MojoSendInvitation(invitation, nullptr, &endpoint, nullptr, 0, nullptr);
+  writer.Emit(3, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  MojoHandle a, b;
+  r = MojoCreateMessagePipe(nullptr, &a, &b);
+  writer.Emit(4, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Transfer B to the acceptor through the bootstrap pipe.
+  r = SendMessageWithHandle(pipe, "transfer-b1", b);
+  writer.Emit(5, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  // w1 routes over the wire to the acceptor's B'.
+  r = SendPayload(a, "w1");
+  writer.Emit(6, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // The sync marker on the bootstrap pipe: the acceptor has queued m0..m8 on
+  // A (per-link FIFO on its side), so reading them now cannot free blocks
+  // before m8's put-time allocation.
+  std::string payload;
+  r = RecvPayload(pipe, &payload);
+  base::DictValue sync_extra;
+  sync_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  writer.Emit(7, "message", ResultName(r), sync_extra);
+  if (r != MOJO_RESULT_OK || payload != "sync") {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Read m0..m8 from A and verify each payload.
+  for (int i = 0; i < 9; ++i) {
+    r = RecvPayload(a, &payload);
+    base::DictValue m_extra;
+    m_extra.Set("payload_hex", HexEncode(
+        reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+    writer.Emit(8 + i, "message", ResultName(r), m_extra);
+    if (r != MOJO_RESULT_OK || payload != MemoryPayload(i)) {
+      writer.WriteOut();
+      return 1;
+    }
+  }
+
+  // Receive the transfer-back and extract B'' (the broker completes the
+  // bypass locally).
+  MojoHandle b2;
+  r = RecvMessageWithHandle(pipe, &payload, &b2);
+  base::DictValue back_extra;
+  back_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  back_extra.Set("handles", static_cast<int>(b2 != MOJO_HANDLE_INVALID ? 1 : 0));
+  writer.Emit(17, "message", ResultName(r), back_extra);
+  if (r != MOJO_RESULT_OK || payload != "transfer-back" ||
+      b2 == MOJO_HANDLE_INVALID) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // w2 round trip on A/B'' (local after the bypass).
+  r = SendPayload(a, "w2");
+  writer.Emit(18, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  r = RecvPayload(b2, &payload);
+  base::DictValue w2_extra;
+  w2_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  writer.Emit(19, "message", ResultName(r), w2_extra);
+  if (r != MOJO_RESULT_OK || payload != "w2") {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // w3 on the bootstrap pipe: the pacing signal that the memory expansion
+  // completed on the acceptor side (the broker sent ProvideMemory before w3;
+  // the acceptor's buffer registration precedes the w3 delivery).
+  r = SendPayload(pipe, "w3");
+  writer.Emit(20, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // m9 and m10 on the bootstrap pipe (fragment-backed from the new buffer).
+  for (int i = 9; i <= 10; ++i) {
+    r = RecvPayload(pipe, &payload);
+    base::DictValue m_extra;
+    m_extra.Set("payload_hex", HexEncode(
+        reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+    writer.Emit(20 + i - 8, "message", ResultName(r), m_extra);
+    if (r != MOJO_RESULT_OK || payload != MemoryPayload(i)) {
+      writer.WriteOut();
+      return 1;
+    }
+  }
+
+  MojoClose(a);
+  writer.Emit(23, "result", ResultName(MOJO_RESULT_OK), extra);
+  MojoClose(b2);
+  writer.Emit(24, "result", ResultName(MOJO_RESULT_OK), extra);
+  MojoClose(pipe);
+  writer.Emit(25, "result", ResultName(MOJO_RESULT_OK), extra);
+
+  writer.Emit(26, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  writer.WriteOut();
+  return 0;
+}
+
+int RunMemoryAcceptor(int socket_fd, const char* events_path) {
+  mojo::core::Init();
+
+  EventWriter writer(events_path);
+  writer.Emit(0, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  base::DictValue extra;
+
+  MojoInvitationTransportEndpoint endpoint = SocketEndpoint(socket_fd);
+  MojoHandle invitation;
+  MojoResult r = MojoAcceptInvitation(&endpoint, nullptr, &invitation);
+  writer.Emit(1, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  MojoHandle pipe;
+  r = MojoExtractMessagePipeFromInvitation(invitation, "bootstrap", 9, nullptr, &pipe);
+  writer.Emit(2, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Receive B' (the transferred portal).
+  std::string payload;
+  MojoHandle b1;
+  r = RecvMessageWithHandle(pipe, &payload, &b1);
+  base::DictValue t_extra;
+  t_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  t_extra.Set("handles", static_cast<int>(b1 != MOJO_HANDLE_INVALID ? 1 : 0));
+  writer.Emit(3, "message", ResultName(r), t_extra);
+  if (r != MOJO_RESULT_OK || payload != "transfer-b1" ||
+      b1 == MOJO_HANDLE_INVALID) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Receive w1 over the wire.
+  r = RecvPayload(b1, &payload);
+  base::DictValue w1_extra;
+  w1_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  writer.Emit(4, "message", ResultName(r), w1_extra);
+  if (r != MOJO_RESULT_OK || payload != "w1") {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // m0..m8 on B'. m0..m7 consume the primary 256-byte blocks; m8's fragment
+  // allocation fails (the parcel goes inline) and triggers the RequestMemory
+  // round trip.
+  for (int i = 0; i < 9; ++i) {
+    r = SendPayload(b1, MemoryPayload(i));
+    writer.Emit(5 + i, "result", ResultName(r), extra);
+    if (r != MOJO_RESULT_OK) {
+      writer.WriteOut();
+      return 1;
+    }
+  }
+
+  // The sync marker on the bootstrap pipe (the broker reads m0..m8 after it).
+  r = SendPayload(pipe, "sync");
+  writer.Emit(14, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Transfer B' back through the bootstrap pipe (the proxy path). The
+  // ProvideMemory round trip completes during this exchange.
+  r = SendMessageWithHandle(pipe, "transfer-back", b1);
+  writer.Emit(15, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // w3: the pacing round trip. The IO thread processes the broker's
+  // ProvideMemory before the w3 delivery (arrival order), so the new buffer is
+  // registered locally when this returns.
+  r = RecvPayload(pipe, &payload);
+  base::DictValue w3_extra;
+  w3_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  writer.Emit(16, "message", ResultName(r), w3_extra);
+  if (r != MOJO_RESULT_OK || payload != "w3") {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // m9 and m10 on the bootstrap pipe — fragment-backed from the new buffer.
+  r = SendPayload(pipe, MemoryPayload(9));
+  writer.Emit(17, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  r = SendPayload(pipe, MemoryPayload(10));
+  writer.Emit(18, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // The broker closes its bootstrap end: the read fails with
+  // FAILED_PRECONDITION (peer closed).
+  r = RecvPayload(pipe, &payload);
+  base::DictValue c_extra;
+  c_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  writer.Emit(19, "message", ResultName(r), c_extra);
+
+  MojoClose(pipe);
+  MojoClose(invitation);
+  writer.Emit(20, "result", ResultName(MOJO_RESULT_OK), extra);
+  writer.Emit(21, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  writer.WriteOut();
+  return (r == MOJO_RESULT_FAILED_PRECONDITION) ? 0 : 1;
+}
+
+// The Phase 5 block-capacity exhaustion scenario (official broker and
+// acceptor sides):
+//
+//   invite-broker-exhaust  <socket-fd> <events.jsonl>
+//   invite-acceptor-exhaust <socket-fd> <events.jsonl>
+//
+// The primary buffer's 64-byte block pool (RouterLinkState) holds 1483
+// allocable blocks. Each portal transfer through the bootstrap pipe consumes
+// one RouterLinkState on the broker (never freed while the pair is held), so
+// after 1481 transfers the pool is exhausted. The 1482nd transfer's
+// `TryAllocateRouterLinkState` fails:
+//   - the transfer falls back to the plain proxy path
+//     (`SerializeNewRouterAndConfigureProxy` with no proxy-bypass fields,
+//     because the transferred router's outward peer is local);
+//   - the broker lobbies `RequestBlockCapacity(64)` (the unconditional
+//     `TryAllocateRouterLinkState` lobby), allocates a 64 KiB buffer locally
+//     (it is not an allocation delegate), initializes it as a 64-byte block
+//     allocator, and shares it with the acceptor via `AddBlockBuffer{id=1,
+//     64}`;
+//   - the acceptor adopts the new buffer; subsequent transfers' RouterLinkStates
+//     come from buffer 1 (cross-buffer fragment resolution);
+//   - the broker's proxy for the 1482nd transfer runs `MaybeStartSelfBypass`
+//     and, because its outward peer is local, `StartSelfBypassToLocalPeer`:
+//     it allocates a link state from the new buffer and sends
+//     `BypassPeerWithLink` to the acceptor, which adopts the bypass (the
+//     sealed routing-court machinery).
+//
+// The court seals the RECEIVE side of the block-capacity expansion
+// (AddBlockBuffer adoption + cross-buffer fragment resolution) and the
+// exhausted-pool proxy transfer. The `RequestMemory`/`ProvideMemory` SEND
+// round trip (the acceptor as allocation delegate) is not reachable in this
+// epoch's two-node topology (see STATUS.md).
+// ---------------------------------------------------------------------------
+
+// The number of portal transfers: 1 (transfer-b1) + 1485. The 64-byte pool
+// (1483 allocable blocks) is consumed by transfer-b1, the two bridge-bypass
+// states, and transfers 2..1481; the 1482nd transfer triggers the expansion;
+// transfers 1483..1486 come from the new buffer.
+constexpr int kExhaustTransfers = 1486;
+
+std::string TransferPayload(int i) {
+  return "transfer-" + std::to_string(i);
+}
+
+int RunExhaustBroker(int socket_fd, const char* events_path) {
+  mojo::core::Configuration config;
+  config.is_broker_process = true;
+  config.force_direct_shared_memory_allocation = true;
+  mojo::core::Init(config);
+
+  EventWriter writer(events_path);
+  uint64_t op = 0;
+  writer.Emit(op++, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  base::DictValue extra;
+
+  MojoHandle invitation;
+  MojoResult r = MojoCreateInvitation(nullptr, &invitation);
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  MojoHandle pipe;
+  r = MojoAttachMessagePipeToInvitation(invitation, "bootstrap", 9, nullptr, &pipe);
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  MojoInvitationTransportEndpoint endpoint = SocketEndpoint(socket_fd);
+  r = MojoSendInvitation(invitation, nullptr, &endpoint, nullptr, 0, nullptr);
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Transfer 1: B1 through the bootstrap pipe. The pair (A1, B1) is HELD on
+  // both ends for the rest of the run: the RouterLinkState stays allocated.
+  MojoHandle a, b;
+  r = MojoCreateMessagePipe(nullptr, &a, &b);
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  r = SendMessageWithHandle(pipe, "transfer-b1", b);
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // w1 on A (2 bytes; the acceptor verifies the transferred pipe works).
+  r = SendPayload(a, "w1");
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Transfers 2..kExhaustTransfers: fresh pairs, portal through the bootstrap.
+  // The A ends are HELD (never closed) so the RouterLinkStates stay allocated;
+  // the transferred B ends are held by the acceptor.
+  for (int i = 2; i <= kExhaustTransfers; ++i) {
+    MojoHandle ai, bi;
+    r = MojoCreateMessagePipe(nullptr, &ai, &bi);
+    writer.Emit(op++, "result", ResultName(r), extra);
+    if (r != MOJO_RESULT_OK) {
+      writer.WriteOut();
+      return 1;
+    }
+    r = SendMessageWithHandle(pipe, TransferPayload(i), bi);
+    writer.Emit(op++, "result", ResultName(r), extra);
+    if (r != MOJO_RESULT_OK) {
+      writer.WriteOut();
+      return 1;
+    }
+    (void)ai;  // held until process exit; closing would free the link state
+  }
+
+  // Close the bootstrap pipe; the acceptor observes peer closure.
+  MojoClose(pipe);
+  writer.Emit(op++, "result", ResultName(MOJO_RESULT_OK), extra);
+  writer.Emit(op++, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  writer.WriteOut();
+  return 0;
+}
+
+int RunExhaustAcceptor(int socket_fd, const char* events_path) {
+  mojo::core::Init();
+
+  EventWriter writer(events_path);
+  uint64_t op = 0;
+  writer.Emit(op++, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  base::DictValue extra;
+
+  MojoInvitationTransportEndpoint endpoint = SocketEndpoint(socket_fd);
+  MojoHandle invitation;
+  MojoResult r = MojoAcceptInvitation(&endpoint, nullptr, &invitation);
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  MojoHandle pipe;
+  r = MojoExtractMessagePipeFromInvitation(invitation, "bootstrap", 9, nullptr, &pipe);
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Receive transfer-b1 and w1.
+  std::string payload;
+  MojoHandle b1;
+  r = RecvMessageWithHandle(pipe, &payload, &b1);
+  base::DictValue t_extra;
+  t_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  t_extra.Set("handles", static_cast<int>(b1 != MOJO_HANDLE_INVALID ? 1 : 0));
+  writer.Emit(op++, "message", ResultName(r), t_extra);
+  if (r != MOJO_RESULT_OK || payload != "transfer-b1" ||
+      b1 == MOJO_HANDLE_INVALID) {
+    writer.WriteOut();
+    return 1;
+  }
+  r = RecvPayload(b1, &payload);
+  base::DictValue w1_extra;
+  w1_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  writer.Emit(op++, "message", ResultName(r), w1_extra);
+  if (r != MOJO_RESULT_OK || payload != "w1") {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Receive transfers 2..kExhaustTransfers, HOLDING each portal (never
+  // closed — closing would free the RouterLinkState). The broker's
+  // AddBlockBuffer (the exhausted-pool expansion) and its proxy self-bypass
+  // (BypassPeerWithLink) are ipcz-internal, handled by the IO thread.
+  for (int i = 2; i <= kExhaustTransfers; ++i) {
+    MojoHandle bi;
+    r = RecvMessageWithHandle(pipe, &payload, &bi);
+    base::DictValue tr_extra;
+    tr_extra.Set("payload_hex", HexEncode(
+        reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+    tr_extra.Set("handles", static_cast<int>(bi != MOJO_HANDLE_INVALID ? 1 : 0));
+    writer.Emit(op++, "message", ResultName(r), tr_extra);
+    if (r != MOJO_RESULT_OK || payload != TransferPayload(i) ||
+        bi == MOJO_HANDLE_INVALID) {
+      writer.WriteOut();
+      return 1;
+    }
+    (void)bi;  // held until process exit
+  }
+
+  // The broker closed the bootstrap pipe.
+  r = RecvPayload(pipe, &payload);
+  base::DictValue c_extra;
+  c_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  writer.Emit(op++, "message", ResultName(r), c_extra);
+
+  MojoClose(pipe);
+  MojoClose(invitation);
+  writer.Emit(op++, "result", ResultName(MOJO_RESULT_OK), extra);
+  writer.Emit(op++, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  writer.WriteOut();
+  return (r == MOJO_RESULT_FAILED_PRECONDITION) ? 0 : 1;
+}
+
+// ---------------------------------------------------------------------------
+// Bypass court (acceptor-initiated block-capacity exhaustion)
+// ---------------------------------------------------------------------------
+//   invite-broker-bypass   <socket-fd> <events.jsonl>
+//   invite-acceptor-bypass <socket-fd> <events.jsonl>
+//
+// This court seals the SEND side of the `RequestMemory`/`ProvideMemory`/
+// `AddBlockBuffer` round trip. The ACCEPTOR creates fresh local pairs and
+// transfers one end of each through the bootstrap pipe
+// (`SerializeNewRouterWithLocalPeer`): every transfer allocates one
+// `RouterLinkState` from the shared 64-byte pool (held while both ends of
+// the pair stay open). When the pool exhausts, the unconditional
+// `TryAllocateRouterLinkState` lobby fires `RequestBlockCapacity(64)` and,
+// because the acceptor connected as the allocation delegate, sends
+// `RequestMemory` to the broker; the broker's `OnRequestMemory` allocates a
+// 64 KiB buffer and replies `ProvideMemory`; the acceptor adopts it and
+// shares it back via `AddBlockBuffer`.
+//
+// The baseline runs the official oracle acceptor (which performs the same
+// flow); the interop runs the native Rust `bypass-acceptor`. The broker's
+// event stream must be byte-identical. The exhaustion point itself is
+// allocation-interleaving dependent (the peer's IO thread frees the transfer
+// payload fragments concurrently) and is a documented normalized residual.
+// ---------------------------------------------------------------------------
+
+// The number of acceptor-initiated portal transfers. The shared 64-byte pool
+// (1483 allocable blocks) is consumed by the prelude (transfer-b1, the two
+// bridge-bypass states) and then one block per acceptor transfer; the
+// exhaustion and the `RequestMemory` round trip therefore occur mid-loop and
+// the remainder resolve from the new buffer.
+constexpr int kBypassTransfers = 1520;
+
+int RunBypassBroker(int socket_fd, const char* events_path) {
+  mojo::core::Configuration config;
+  config.is_broker_process = true;
+  config.force_direct_shared_memory_allocation = true;
+  mojo::core::Init(config);
+
+  EventWriter writer(events_path);
+  uint64_t op = 0;
+  writer.Emit(op++, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  base::DictValue extra;
+
+  MojoHandle invitation;
+  MojoResult r = MojoCreateInvitation(nullptr, &invitation);
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  MojoHandle pipe;
+  r = MojoAttachMessagePipeToInvitation(invitation, "bootstrap", 9, nullptr, &pipe);
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  MojoInvitationTransportEndpoint endpoint = SocketEndpoint(socket_fd);
+  r = MojoSendInvitation(invitation, nullptr, &endpoint, nullptr, 0, nullptr);
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // The routing-court prelude: transfer B1 through the bootstrap pipe and
+  // write w1 on A1 (the acceptor verifies the transferred pipe works). The
+  // pair (A1, B1) is held for the rest of the run.
+  MojoHandle a1, b1;
+  r = MojoCreateMessagePipe(nullptr, &a1, &b1);
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  r = SendMessageWithHandle(pipe, "transfer-b1", b1);
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  r = SendPayload(a1, "w1");
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // The acceptor's transfers: each arrives with exactly one portal handle,
+  // which is extracted and HELD (never closed — closing would free the
+  // RouterLinkState).
+  std::string payload;
+  for (int i = 0; i < kBypassTransfers; ++i) {
+    MojoHandle bi;
+    r = RecvMessageWithHandle(pipe, &payload, &bi);
+    base::DictValue tr_extra;
+    tr_extra.Set("payload_hex", HexEncode(
+        reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+    tr_extra.Set("handles", static_cast<int>(bi != MOJO_HANDLE_INVALID ? 1 : 0));
+    writer.Emit(op++, "message", ResultName(r), tr_extra);
+    if (r != MOJO_RESULT_OK || payload != TransferPayload(i) ||
+        bi == MOJO_HANDLE_INVALID) {
+      writer.WriteOut();
+      return 1;
+    }
+    (void)bi;  // held until process exit
+  }
+
+  // The sync marker after all transfers.
+  r = RecvPayload(pipe, &payload);
+  base::DictValue s_extra;
+  s_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  writer.Emit(op++, "message", ResultName(r), s_extra);
+  if (r != MOJO_RESULT_OK || payload != "sync") {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Close the bootstrap pipe; the acceptor observes peer closure.
+  MojoClose(pipe);
+  writer.Emit(op++, "result", ResultName(MOJO_RESULT_OK), extra);
+  writer.Emit(op++, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  writer.WriteOut();
+  return 0;
+}
+
+int RunBypassAcceptor(int socket_fd, const char* events_path) {
+  mojo::core::Init();
+
+  EventWriter writer(events_path);
+  uint64_t op = 0;
+  writer.Emit(op++, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  base::DictValue extra;
+
+  MojoInvitationTransportEndpoint endpoint = SocketEndpoint(socket_fd);
+  MojoHandle invitation;
+  MojoResult r = MojoAcceptInvitation(&endpoint, nullptr, &invitation);
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+  MojoHandle pipe;
+  r = MojoExtractMessagePipeFromInvitation(invitation, "bootstrap", 9, nullptr, &pipe);
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // Receive transfer-b1 and w1 (the routing-court prelude).
+  std::string payload;
+  MojoHandle b1;
+  r = RecvMessageWithHandle(pipe, &payload, &b1);
+  base::DictValue t_extra;
+  t_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  t_extra.Set("handles", static_cast<int>(b1 != MOJO_HANDLE_INVALID ? 1 : 0));
+  writer.Emit(op++, "message", ResultName(r), t_extra);
+  if (r != MOJO_RESULT_OK || payload != "transfer-b1" ||
+      b1 == MOJO_HANDLE_INVALID) {
+    writer.WriteOut();
+    return 1;
+  }
+  r = RecvPayload(b1, &payload);
+  base::DictValue w1_extra;
+  w1_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  writer.Emit(op++, "message", ResultName(r), w1_extra);
+  if (r != MOJO_RESULT_OK || payload != "w1") {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // The acceptor-initiated transfers: each creates a fresh pair and sends one
+  // end through the bootstrap pipe, HOLDING the local end (never closed —
+  // closing would free the RouterLinkState). The shared 64-byte pool
+  // exhausts mid-loop; the `RequestMemory`/`ProvideMemory`/`AddBlockBuffer`
+  // round trip is ipcz-internal, handled by the IO thread.
+  for (int i = 0; i < kBypassTransfers; ++i) {
+    MojoHandle ai, bi;
+    r = MojoCreateMessagePipe(nullptr, &ai, &bi);
+    if (r != MOJO_RESULT_OK) {
+      writer.WriteOut();
+      return 1;
+    }
+    r = SendMessageWithHandle(pipe, TransferPayload(i), bi);
+    writer.Emit(op++, "result", ResultName(r), extra);
+    if (r != MOJO_RESULT_OK) {
+      writer.WriteOut();
+      return 1;
+    }
+    (void)ai;  // held until process exit
+  }
+
+  // The sync marker.
+  r = SendPayload(pipe, "sync");
+  writer.Emit(op++, "result", ResultName(r), extra);
+  if (r != MOJO_RESULT_OK) {
+    writer.WriteOut();
+    return 1;
+  }
+
+  // The broker closed the bootstrap pipe.
+  r = RecvPayload(pipe, &payload);
+  base::DictValue c_extra;
+  c_extra.Set("payload_hex", HexEncode(
+      reinterpret_cast<const uint8_t*>(payload.data()), payload.size()));
+  writer.Emit(op++, "message", ResultName(r), c_extra);
+
+  MojoClose(pipe);
+  MojoClose(invitation);
+  writer.Emit(op++, "result", ResultName(MOJO_RESULT_OK), extra);
+  writer.Emit(op++, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  writer.WriteOut();
+  return (r == MOJO_RESULT_FAILED_PRECONDITION) ? 0 : 1;
+}
