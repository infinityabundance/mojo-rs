    {"id": 14, "op": "close", "args": {"handle": "c"}, "expect": {"result": "MOJO_RESULT_OK"}}
  ],
  "expected_contract": {
    "note": "peer close: buffered data stays readable (READABLE + PEER_CLOSED), then reads FAILED_PRECONDITION; writes to a closed consumer FAILED_PRECONDITION; begin_write FAILED_PRECONDITION"
