    {"id": 2, "op": "write_data", "args": {"handle": "p", "elements_hex": "0a0b", "flags": []}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 3, "op": "close", "args": {"handle": "p"}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 4, "op": "query_signals_state", "args": {"handle": "c"}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 5, "op": "read_data", "args": {"handle": "c", "num_bytes": 2, "flags": []}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 6, "op": "query_signals_state", "args": {"handle": "c"}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 7, "op": "read_data", "args": {"handle": "c", "num_bytes": 4, "flags": []}, "expect": {"result": "MOJO_RESULT_FAILED_PRECONDITION"}},
