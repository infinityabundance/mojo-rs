    {"id": 2, "op": "trap_create", "args": {"flags": 0}, "expect": {"result": "MOJO_RESULT_OK", "produce": ["t0"]}},
    {"id": 3, "op": "trap_add_trigger", "args": {"trap": "t0", "handle": "h0", "signals": ["READABLE"], "context": 7}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 4, "op": "trap_arm", "args": {"trap": "t0"}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 5, "op": "write_message", "args": {"handle": "h1", "payload_hex": "10", "handles": [], "flags": 0}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 6, "op": "drain_trap_events", "args": {"trap": "t0", "count": 1, "timeout_ms": 5000}, "expect": {"result": "MOJO_RESULT_OK"}},
