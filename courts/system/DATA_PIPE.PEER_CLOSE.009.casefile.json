    {"id": 9, "op": "close", "args": {"handle": "c2"}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 10, "op": "query_signals_state", "args": {"handle": "p2"}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 11, "op": "write_data", "args": {"handle": "p2", "elements_hex": "01", "flags": []}, "expect": {"result": "MOJO_RESULT_FAILED_PRECONDITION"}},
