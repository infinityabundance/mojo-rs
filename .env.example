# ---------------------------------------------------------------------------
# mojo-rs local environment template (portable).
#
# Copy to `config/local.env` (git-ignored) and edit. Every variable here is a
# portable default or an empty placeholder -- NEVER a host-specific absolute
# path. Host-specific values belong in the ignored local file only.
#
# Precedence (highest first, see scripts/configure_local_environment.sh):
#   1. explicit command-line arguments
#   2. already-exported environment variables
#   3. config/local.env  (or .env.local)
#   4. portable computed defaults
# ---------------------------------------------------------------------------

# Root under which ALL mojo-rs Docker daemon state lives: data-root, exec-root,
# buildkit, run/ (docker.sock + docker.pid), logs/, tmp/.
# Default: ${XDG_DATA_HOME:-$HOME/.local/share}/mojo-rs/docker
MOJO_RS_DOCKER_ROOT=

# DOCKER_HOST for the isolated project daemon.
# Default: unix://$MOJO_RS_DOCKER_ROOT/run/docker.sock
MOJO_RS_DOCKER_HOST=

# Directory containing Ubuntu minimal source images (never written by the court).
# Default: ${XDG_DATA_HOME:-$HOME/.local/share}/mojo-rs/images
MOJO_RS_UBUNTU_IMAGE_DIR=

# Absolute path to a specific Ubuntu minimal image (overrides discovery).
# Discovery never silently picks a file when none or several are suitable.
MOJO_RS_UBUNTU_IMAGE=

# Build cache root (rustup/cargo homes, ccache, depot_tools).
# Default: ${XDG_CACHE_HOME:-$HOME/.cache}/mojo-rs
MOJO_RS_BUILD_CACHE=

# Root for court artifacts and generated evidence produced outside the repo.
# Default: $MOJO_RS_DOCKER_ROOT/artifacts
MOJO_RS_ARTIFACT_ROOT=

# Minimum free space (bytes) the storage verification court requires.
# Default: 53687091200 (50 GiB)
MOJO_RS_MIN_FREE_BYTES=

# Minimum free space for the oracle/court build directory (bytes).
# Default: 32212254720 (30 GiB)
MOJO_RS_MIN_FREE_BUILD_BYTES=

# Directory containing verified rootless tooling binaries (rootlesskit v2.3.2,
# slirp4netns v1.3.2, sha256-verified). Optional; when unset the tooling is
# downloaded from pinned release URLs (where still available).
MOJO_RS_ROOTLESS_TOOLING_SOURCE=
