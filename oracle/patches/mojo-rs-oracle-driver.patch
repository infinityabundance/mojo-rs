+int main(int argc, char** argv) {
+  // Optional leading `-v`/`--enable-logging` switches (used for debugging the
+  // ipcz state machine) are kept for `base::CommandLine::Init` but skipped
+  // when locating the positional command and arguments.
+  int pos = 1;
+  while (pos < argc && argv[pos][0] == '-') {
+    ++pos;
+  }
+  if (argc - pos < 1) {
+    fprintf(stderr,
+            "usage: mojo_rs_oracle_driver <baseline|invite-broker|invite-acceptor|\n"
+            "       invite-broker-routing|invite-acceptor-routing|\n"
+            "       invite-broker-memory|invite-acceptor-memory|\n"
+            "       invite-broker-exhaust|invite-acceptor-exhaust|\n"
+            "       invite-broker-bypass|invite-acceptor-bypass> ...\n");
+    return 2;
+  }
+  std::string command = argv[pos];
+  const int positional = argc - pos;
+  char** pos_argv = argv + (pos - 1);
+  pos_argv[0] = argv[0];
+  pos_argv[1] = argv[pos];
+  for (int i = 2; i < positional; ++i) {
+    pos_argv[i] = argv[pos + i - 1];
+  }
+
+  // Base-process plumbing required by Chromium's base library (shared memory
+  // temp dirs, at-exit callbacks, message loop) before any Mojo IPC runs.
+  base::CommandLine::Init(argc, argv);
+  base::AtExitManager exit_manager;
+
+  // Optional verbose ipcz tracing (MOJO_RS_ORACLE_VERBOSE=N): route DVLOG up
+  // to level N to stderr so the router state machine is observable. The
+  // per-file vlog level is driven by the `--v` switch via CommandLine.
+  if (const char* verbose = getenv("MOJO_RS_ORACLE_VERBOSE")) {
+    const int level = atoi(verbose);
+    logging::SetMinLogLevel(level > 0 ? -level : 0);
+  }
+
+  if (command == "invite-broker" || command == "invite-acceptor" ||
+      command == "invite-broker-routing" || command == "invite-acceptor-routing" ||
+      command == "invite-broker-memory" || command == "invite-acceptor-memory" ||
+      command == "invite-broker-exhaust" || command == "invite-acceptor-exhaust" ||
+      command == "invite-broker-bypass" || command == "invite-acceptor-bypass") {
+    // The transport channel runs on a dedicated IO thread with an IO message
+    // pump (the pump registers the IOWatcher the channel requires).
+    base::Thread io_thread("mojo-rs-oracle-io");
+    base::Thread::Options io_options(base::MessagePumpType::IO, 0);
+    if (!io_thread.StartWithOptions(std::move(io_options))) {
+      fprintf(stderr, "failed to start IO thread\n");
+      return 1;
+    }
+    mojo::core::ScopedIPCSupport ipc_support(
+        io_thread.task_runner(),
+        mojo::core::ScopedIPCSupport::ShutdownPolicy::CLEAN);
+    if (command == "invite-broker") {
+      if (positional != 3) {
+        fprintf(stderr,
+                "usage: mojo_rs_oracle_driver invite-broker <socket-fd> <events.jsonl>\n");
+        return 2;
+      }
+      int socket_fd = atoi(pos_argv[2]);
+      return invite::RunBroker(socket_fd, pos_argv[3]);
+    }
+    if (command == "invite-broker-routing") {
+      if (positional != 3) {
+        fprintf(stderr,
+                "usage: mojo_rs_oracle_driver invite-broker-routing <socket-fd> <events.jsonl>\n");
+        return 2;
+      }
+      int socket_fd = atoi(pos_argv[2]);
+      return invite::RunRoutingBroker(socket_fd, pos_argv[3]);
+    }
+    if (command == "invite-acceptor-routing") {
+      if (positional != 3) {
+        fprintf(stderr,
+                "usage: mojo_rs_oracle_driver invite-acceptor-routing <socket-fd> <events.jsonl>\n");
+        return 2;
+      }
+      int socket_fd = atoi(pos_argv[2]);
+      return invite::RunRoutingAcceptor(socket_fd, pos_argv[3]);
+    }
+    if (command == "invite-broker-memory") {
+      if (positional != 3) {
+        fprintf(stderr,
+                "usage: mojo_rs_oracle_driver invite-broker-memory <socket-fd> <events.jsonl>\n");
+        return 2;
+      }
+      int socket_fd = atoi(pos_argv[2]);
+      return invite::RunMemoryBroker(socket_fd, pos_argv[3]);
+    }
+    if (command == "invite-acceptor-memory") {
+      if (positional != 3) {
+        fprintf(stderr,
+                "usage: mojo_rs_oracle_driver invite-acceptor-memory <socket-fd> <events.jsonl>\n");
+        return 2;
+      }
+      int socket_fd = atoi(pos_argv[2]);
+      return invite::RunMemoryAcceptor(socket_fd, pos_argv[3]);
+    }
+    if (command == "invite-broker-exhaust") {
+      if (positional != 3) {
+        fprintf(stderr,
+                "usage: mojo_rs_oracle_driver invite-broker-exhaust <socket-fd> <events.jsonl>\n");
+        return 2;
+      }
+      int socket_fd = atoi(pos_argv[2]);
+      return invite::RunExhaustBroker(socket_fd, pos_argv[3]);
+    }
+    if (command == "invite-acceptor-exhaust") {
+      if (positional != 3) {
+        fprintf(stderr,
+                "usage: mojo_rs_oracle_driver invite-acceptor-exhaust <socket-fd> <events.jsonl>\n");
+        return 2;
+      }
+      int socket_fd = atoi(pos_argv[2]);
+      return invite::RunExhaustAcceptor(socket_fd, pos_argv[3]);
+    }
+    if (command == "invite-broker-bypass") {
+      if (positional != 3) {
+        fprintf(stderr,
+                "usage: mojo_rs_oracle_driver invite-broker-bypass <socket-fd> <events.jsonl>\n");
+        return 2;
+      }
+      int socket_fd = atoi(pos_argv[2]);
+      return invite::RunBypassBroker(socket_fd, pos_argv[3]);
+    }
+    if (command == "invite-acceptor-bypass") {
+      if (positional != 3) {
+        fprintf(stderr,
+                "usage: mojo_rs_oracle_driver invite-acceptor-bypass <socket-fd> <events.jsonl>\n");
+        return 2;
+      }
+      int socket_fd = atoi(pos_argv[2]);
+      return invite::RunBypassAcceptor(socket_fd, pos_argv[3]);
+    }
+    if (positional != 3) {
+      fprintf(stderr,
+              "usage: mojo_rs_oracle_driver invite-acceptor <socket-fd> <events.jsonl>\n");
+      return 2;
+    }
+    int socket_fd = atoi(pos_argv[2]);
+    return invite::RunAcceptor(socket_fd, pos_argv[3]);
+  }
+
+  // Register the C API thunks via the embedder. Embedders must NOT call
+  // MojoInitialize() (it returns MOJO_RESULT_UNIMPLEMENTED for embedders);
+  // mojo::core::Init() initializes the ipcz node and installs the system
+  // thunks.
+  mojo::core::Init();
+  MojoResult init_result = MOJO_RESULT_OK;
+  {
+    MojoHandle a, b;
+    if (MojoCreateMessagePipe(nullptr, &a, &b) == MOJO_RESULT_OK) {
+      MojoClose(a);
+      MojoClose(b);
+    } else {
+      init_result = MOJO_RESULT_INTERNAL;
+    }
+  }
+
+  if (argc < 2) {
+    fprintf(stderr,
+            "usage: mojo_rs_oracle_driver baseline <casefile> <events.jsonl>\n");
+    return 2;
+  }
+  if (command == "--self-check") {
+    printf("oracle driver self-check ok (init=%s)\n",
+           ResultName(init_result).c_str());
+    return 0;
+  }
+  if (command != "baseline" || argc != 4) {
+    fprintf(stderr,
+            "usage: mojo_rs_oracle_driver baseline <casefile> <events.jsonl>\n");
+    return 2;
+  }
+
+  std::ifstream f(argv[2]);
+  std::string text((std::istreambuf_iterator<char>(f)),
+                   std::istreambuf_iterator<char>());
+  auto parsed = base::JSONReader::ReadAndReturnValueWithError(text, 0);
+  if (!parsed.has_value() || !parsed->is_dict()) {
+    fprintf(stderr, "casefile parse error: %s\n",
+            parsed.error().message.c_str());
+    return 1;
+  }
+  const base::DictValue& casefile = parsed->GetDict();
+
+  Harness harness;
+  g_harness = &harness;
+  EventWriter writer(argv[3]);
+
+  writer.Emit(0, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  const base::ListValue* operations = casefile.FindList("operations");
+  if (!operations) {
+    fprintf(stderr, "casefile has no operations list\n");
+    return 1;
+  }
+  for (const auto& opv : *operations) {
+    const base::DictValue& op = opv.GetDict();
+    uint64_t op_id = op.FindInt("id").value_or(0);
+    const std::string* op_name = op.FindString("op");
+    const base::DictValue* args = op.FindDict("args");
+    const base::DictValue* expect = op.FindDict("expect");
+    base::DictValue empty_args;
+    base::DictValue empty_expect;
+    if (!args) {
+      args = &empty_args;
+    }
+    if (!expect) {
+      expect = &empty_expect;
+    }
+    if (!op_name) {
+      fprintf(stderr, "operation missing 'op'\n");
+      writer.WriteOut();
+      return 1;
+    }
+    if (*op_name == "message_pipe_create") {
+      OpMessagePipeCreate(&harness, &writer, op_id, *expect);
+    } else if (*op_name == "write_message") {
+      OpWriteMessage(&harness, &writer, op_id, *args);
+    } else if (*op_name == "read_message") {
+      OpReadMessage(&harness, &writer, op_id, *args);
+    } else if (*op_name == "query_signals_state") {
+      OpQuerySignals(&harness, &writer, op_id, *args);
+    } else if (*op_name == "close") {
+      OpClose(&harness, &writer, op_id, *args);
+    } else if (*op_name == "wait") {
+      OpWait(&harness, &writer, op_id, *args);
+    } else if (*op_name == "platform_handle_wrap") {
+      OpPlatformHandleWrap(&harness, &writer, op_id, *args, *expect);
+    } else if (*op_name == "platform_handle_unwrap") {
+      OpPlatformHandleUnwrap(&harness, &writer, op_id, *args);
+    } else if (*op_name == "data_pipe_create") {
+      OpDataPipeCreate(&harness, &writer, op_id, *args, *expect);
+    } else if (*op_name == "write_data") {
+      OpWriteData(&harness, &writer, op_id, *args);
+    } else if (*op_name == "begin_write_data") {
+      OpBeginWriteData(&harness, &writer, op_id, *args);
+    } else if (*op_name == "end_write_data") {
+      OpEndWriteData(&harness, &writer, op_id, *args);
+    } else if (*op_name == "read_data") {
+      OpReadData(&harness, &writer, op_id, *args);
+    } else if (*op_name == "begin_read_data") {
+      OpBeginReadData(&harness, &writer, op_id, *args);
+    } else if (*op_name == "end_read_data") {
+      OpEndReadData(&harness, &writer, op_id, *args);
+    } else if (*op_name == "shared_buffer_create") {
+      OpSharedBufferCreate(&harness, &writer, op_id, *args, *expect);
+    } else if (*op_name == "duplicate_buffer_handle") {
+      OpDuplicateBufferHandle(&harness, &writer, op_id, *args, *expect);
+    } else if (*op_name == "map_buffer") {
+      OpMapBuffer(&harness, &writer, op_id, *args, *expect);
+    } else if (*op_name == "unmap_buffer") {
+      OpUnmapBuffer(&harness, &writer, op_id, *args);
+    } else if (*op_name == "read_mapping") {
+      OpReadMapping(&harness, &writer, op_id, *args);
+    } else if (*op_name == "get_buffer_info") {
+      OpGetBufferInfo(&harness, &writer, op_id, *args);
+    } else if (*op_name == "trap_create") {
+      OpTrapCreate(&harness, &writer, op_id, *args, *expect);
+    } else if (*op_name == "trap_add_trigger") {
+      OpTrapAddTrigger(&harness, &writer, op_id, *args);
+    } else if (*op_name == "trap_arm") {
+      OpTrapArm(&harness, &writer, op_id, *args);
+    } else if (*op_name == "trap_remove_trigger") {
+      OpTrapRemoveTrigger(&harness, &writer, op_id, *args);
+    } else if (*op_name == "trap_close") {
+      OpTrapClose(&harness, &writer, op_id, *args);
+    } else if (*op_name == "drain_trap_events") {
+      OpDrainTrapEvents(&harness, &writer, op_id, *args);
+    } else {
+      fprintf(stderr, "unsupported operation: %s\n", op_name->c_str());
+      writer.WriteOut();
+      return 1;
+    }
+  }
+  writer.Emit(0, "lifecycle", "MOJO_RESULT_OK", base::DictValue());
+  writer.WriteOut();
+  return 0;
+}
