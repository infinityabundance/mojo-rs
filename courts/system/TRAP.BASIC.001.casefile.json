    {"id": 8, "op": "trap_arm", "args": {"trap": "t0"}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 9, "op": "close", "args": {"handle": "h1"}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 10, "op": "drain_trap_events", "args": {"trap": "t0", "count": 1, "timeout_ms": 5000}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 11, "op": "trap_remove_trigger", "args": {"trap": "t0", "handle": "h0", "context": 7}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 12, "op": "trap_close", "args": {"trap": "t0"}, "expect": {"result": "MOJO_RESULT_OK"}},
    {"id": 13, "op": "close", "args": {"handle": "h0"}, "expect": {"result": "MOJO_RESULT_OK"}}
